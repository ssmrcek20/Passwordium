<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Views.DodajSecureNote">
  <grid id="rootNote" binding="panDodaj" layout-manager="GridLayoutManager" row-count="9" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="40" left="40" bottom="40" right="40"/>
    <constraints>
      <xy x="20" y="20" width="525" height="576"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="titleNote" class="javax.swing.JLabel">
        <constraints><grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"><preferred-size width="74" height="53"/></grid></constraints>
        <properties><font size="26"/><text value="Dodaj sigurnu bilješku"/></properties>
      </component>

      <component id="lblNameNote" class="javax.swing.JLabel">
        <constraints><grid row="1" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="2" fill="0" indent="0" use-parent-layout="false"><preferred-size width="300" height="-1"/></grid></constraints>
        <properties><font size="16"/><text value="*Naziv:"/></properties>
      </component>
      <component id="txtNameNote" class="javax.swing.JTextField" binding="txtNaziv">
        <constraints><grid row="2" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="0" fill="0" indent="0" use-parent-layout="false"><preferred-size width="300" height="-1"/><maximum-size width="300" height="-1"/></grid></constraints>
        <properties><font size="18"/></properties>
      </component>

      <component id="lblContent" class="javax.swing.JLabel">
        <constraints><grid row="3" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="2" fill="0" indent="0" use-parent-layout="false"><preferred-size width="300" height="-1"/></grid></constraints>
        <properties><font size="16"/><text value="*Sadržaj:"/></properties>
      </component>
      <scrollpane id="noteScroll" binding="scrollSadrzaj">
        <constraints><grid row="4" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="500" height="230"/><maximum-size width="600" height="300"/></grid></constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="noteArea" class="javax.swing.JTextArea" binding="txtSadrzaj">
            <constraints/>
            <properties><font size="16"/><lineWrap value="true"/><wrapStyleWord value="true"/></properties>
          </component>
        </children>
      </scrollpane>

      <component id="lblCategoryNote" class="javax.swing.JLabel">
        <constraints><grid row="5" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="2" fill="0" indent="0" use-parent-layout="false"><preferred-size width="300" height="-1"/></grid></constraints>
        <properties><font size="16"/><text value="Kategorija:"/></properties>
      </component>
      <component id="cmbCategoryNote" class="javax.swing.JComboBox" binding="cmbKategorija">
        <constraints><grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="0" fill="0" indent="0" use-parent-layout="false"><preferred-size width="300" height="-1"/><maximum-size width="300" height="-1"/></grid></constraints>
        <properties><model><item value="Ostalo"/><item value="Posao"/><item value="Privatno"/><item value="Financije"/></model></properties>
      </component>
      <component id="btnNewCategoryNote" class="javax.swing.JButton" binding="btnNovaKategorija">
        <constraints><grid row="6" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Nova kategorija"/></properties>
      </component>

      <component id="btnAddNote" class="javax.swing.JButton" binding="btnDodaj">
        <constraints><grid row="7" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"><maximum-size width="220" height="-1"/></grid></constraints>
        <properties><font size="18"/><text value="Dodaj bilješku"/></properties>
      </component>
      <component id="backNote" class="javax.swing.JLabel" binding="lblNatrag">
        <constraints><grid row="8" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="1" anchor="0" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><font size="16" style="1"/><text value="Natrag na prikaz"/></properties>
      </component>
    </children>
  </grid>
</form>
